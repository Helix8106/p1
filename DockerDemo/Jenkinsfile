pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code downloaded from GitHub'
                bat 'dir'
            }
        }
        stage('Build') {
            steps {
                echo 'Build stage: nothing to compile for a Python program'
            }
        }
        stage('Test') {
            steps {
                bat 'python hello.py'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the application...'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}